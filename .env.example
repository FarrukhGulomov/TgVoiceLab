# Copy to .env and fill in LOCALLY. Never commit .env. Never paste values into chat.
# Secrets are REFERENCES (file:/abs/path with mode 600, or env:NAME) — never literal values in config.

NODE_ENV=development
# Local development: any login you own. PRODUCTION (docker compose): the runtime login tgvl_app (DML only), NOT the owner/superuser.
# Migrations use a different login (tgvl_migrator) through deploy/.env.migrate. See docs/runbooks/deploy-rollback.md.
DATABASE_URL=postgres://tgvl:CHANGE_ME@localhost:5432/tgvl

# Numeric Telegram id of the HUMAN owner. Usernames are not identity. Set by `pnpm bootstrap:owner` flow; required in production.
OWNER_TELEGRAM_USER_ID=
OWNER_TIMEZONE=Asia/Samarkand

# From https://my.telegram.org (for the DEDICATED assistant account). Needed for MESSAGING_ADAPTER=telegram and the live spike.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# file:/abs/path/telegram.session (mode 600) written by `pnpm spike:login`. The session IS account access: treat as a password.
TELEGRAM_SESSION_SECRET_REF=

# Used only by the operator-run `pnpm live:ai-call` test. The service itself does not use OpenAI yet (docs could not be verified from the build sandbox). Never hardcode a model.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_REALTIME_MODEL=
OPENAI_VOICE=
# ga | beta  (wire dialect of the Realtime API; used only by the operator-run `pnpm live:ai-call` test)
OPENAI_REALTIME_DIALECT=ga
# Optional: model used to print the caller's words as `caller:` lines in the live test. Leave empty to skip. Never defaulted.
OPENAI_TRANSCRIPTION_MODEL=

# `pnpm dev:secrets` creates both files under .local/secrets and prints these two lines.
DATA_ENCRYPTION_KEY_REF=
ADMIN_TOKEN_SECRET_REF=

# Calling is OFF by default and cannot be turned on by this flag alone: it additionally needs a real adapter, a feasibility
# evidence artifact bound to the deployed build, a daily budget, a bootstrapped owner, and the durable kill switch switched off.
CALLS_ENABLED=false
CALL_ADAPTER=disabled
CALL_FEASIBILITY_EVIDENCE_PATH=
MEDIA_SOCKET_PATH=/run/assistant/media.sock

# disabled | telegram | fake (fake is development-only and refused in production)
MESSAGING_ADAPTER=disabled
# rules | disabled   (openai is reserved; selecting it fails at startup in this build)
TEXT_AI_ADAPTER=rules

RAW_AUDIO_RECORDING_ENABLED=false
FULL_TRANSCRIPT_RETENTION_ENABLED=false
DAILY_AI_BUDGET_USD=

HTTP_HOST=127.0.0.1
HTTP_PORT=8080
LOG_LEVEL=info
# Set at image build: `node scripts/build-fingerprint.mjs`. Evidence is bound to this value.
BUILD_FINGERPRINT=dev

# ---- Live Telegram spike (experiments/telegram-calls) — ALL required to place a real test call --------------------------
# LIVE_TEST_OPT_IN=yes
# LIVE_TEST_RECIPIENT_ID=<numeric id of a consenting test participant>
# LIVE_TEST_RECIPIENT_CONSENT=yes
# LIVE_TEST_WINDOW_START=2026-10-16T10:00:00+05:00
# LIVE_TEST_WINDOW_END=2026-10-16T10:30:00+05:00
# LIVE_TEST_MAX_SECONDS=30     # 300 for the five-minute G0-D check
# LIVE_TEST_REPEAT=1           # 10 for the consecutive-calls G0-D check
# LIVE_TEST_SCENARIO=answer    # answer | expect_decline | expect_busy

# Operator-run live AI call test only (`pnpm live:ai-call`): AI_VOICE_PROVIDER=openai|gemini. Models are never defaulted.
AI_VOICE_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=
GEMINI_VOICE=
# realtime | client_content  (how Gemini receives the plain-text greeting; model generations differ)
GEMINI_TEXT_MODE=realtime
# on | (empty): let Gemini use Google Search for facts it does not know (queries leave this machine)
GEMINI_GOOGLE_SEARCH=
# Optional BCP-47 hint for spoken output, e.g. uz-UZ (support differs by model; unsupported values show up as a server error)
GEMINI_LANGUAGE_CODE=
