{
  "name": "@tgvl/assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=../../.env watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/infrastructure/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/infrastructure/db/seed-cli.ts",
    "bootstrap:owner": "tsx --env-file-if-exists=../../.env src/cli/bootstrap-owner.ts",
    "dev:secrets": "tsx src/cli/dev-secrets.ts",
    "db:replay-tombstones": "tsx --env-file-if-exists=../../.env src/cli/restore-replay.ts",
    "keys:rotate": "tsx --env-file-if-exists=../../.env src/cli/rotate-keys.ts"
  },
  "dependencies": {
    "@tgvl/contracts": "workspace:*",
    "big-integer": "1.6.52",
    "fastify": "5.12.7",
    "luxon": "3.7.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "telegram": "2.26.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/pg": "8.23.1"
  }
}
