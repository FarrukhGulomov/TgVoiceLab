{
  "name": "tgvoicelab",
  "private": true,
  "version": "0.1.0",
  "description": "Personal AI Executive Assistant over a dedicated Telegram user account",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm --filter @tgvl/contracts run build && pnpm --filter @tgvl/assistant run build",
    "dev": "pnpm --filter @tgvl/assistant run dev",
    "start": "pnpm --filter @tgvl/assistant run start",
    "lint": "eslint .",
    "format": "prettier --check .",
    "typecheck": "pnpm --filter @tgvl/contracts run build && pnpm -r --filter './packages/*' --filter './apps/*' run typecheck",
    "test": "pnpm run test:unit && pnpm run test:contract",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "db:create-test": "node scripts/create-test-db.mjs",
    "db:migrate": "pnpm --filter @tgvl/assistant run db:migrate",
    "db:seed": "pnpm --filter @tgvl/assistant run db:seed",
    "setup:account": "pnpm --filter @tgvl/telegram-calls-spike run login",
    "spike:smoke": "pnpm --filter @tgvl/telegram-calls-spike run smoke",
    "spike:login": "pnpm --filter @tgvl/telegram-calls-spike run login",
    "spike:call": "pnpm --filter @tgvl/telegram-calls-spike run call",
    "live:test": "pnpm --filter @tgvl/telegram-calls-spike run call",
    "bootstrap:owner": "pnpm --filter @tgvl/assistant run bootstrap:owner",
    "dev:secrets": "pnpm --filter @tgvl/assistant run dev:secrets",
    "spike:record-gate": "pnpm --filter @tgvl/telegram-calls-spike run record-gate",
    "spike:evidence": "pnpm --filter @tgvl/telegram-calls-spike run evidence",
    "secrets:scan": "node scripts/check-secrets.mjs",
    "fingerprint": "node scripts/build-fingerprint.mjs",
    "db:replay-tombstones": "pnpm --filter @tgvl/assistant run db:replay-tombstones",
    "keys:rotate": "pnpm --filter @tgvl/assistant run keys:rotate",
    "verify": "pnpm run lint && pnpm run format && pnpm run typecheck && pnpm run build && pnpm run test:all",
    "live:ai-call": "pnpm --filter @tgvl/assistant run live:ai-call",
    "live:gate-calls": "pnpm --filter @tgvl/assistant run live:gate-calls",
    "attest:target-host": "pnpm --filter @tgvl/assistant run attest:target-host",
    "evidence:production": "pnpm --filter @tgvl/assistant run evidence:production"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "9.39.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
